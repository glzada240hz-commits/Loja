# Copie para .env e ajuste. NUNCA versione o .env.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://guto:guto@localhost:5432/guto
# URL pública usada em links do cardápio/rastreio enviados ao cliente
PUBLIC_BASE_URL=http://localhost:3000
# Diretório para fotos de produtos
UPLOAD_DIR=./uploads
# Senha inicial do usuário "admin" criada no seed (troque no primeiro acesso)
SEED_ADMIN_PASSWORD=troque-esta-senha

# WhatsApp Business Platform (Cloud API). Sem estas variáveis o módulo roda em MODO DEMONSTRATIVO.
WHATSAPP_MODE=demo            # demo | cloud
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
